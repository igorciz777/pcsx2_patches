gametitle=WRC avec Sebastien Loeb [SCES 53680] (PAL)

[English language]
author=github.com/igorciz777
description=Switches forced French to English.

// force English language
patch=0,EE,0019cb74,word,64050000
patch=0,EE,0019cba8,word,24050000


[NTSC]
author=github.com/igorciz777
description=Enables leftover NTSC code (60fps patch), slightly crops the bottom of the screen

// switch appcore_c PAL/NTSC parameter from 0(PAL) to 1(NTSC)
patch=0,EE,0010030c,word,00a0402d
// change 512x420 to 512x480
patch=0,EE,0030bf60,word,24050200
patch=0,EE,0030bf68,word,24060200


[Enable Debug Menu]
author=github.com/igorciz777
description=Enables the debug menu

// skip runtimeconfig check
