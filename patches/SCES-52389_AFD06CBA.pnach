[Disable Dynamic Draw Distance]
author=github.com/igorciz777, Agrippa (static draw distance address)
description=Disables dynamic draw distance, performance boost

// check if encrypted
patch=1,EE,D04A4704,extended,05010063
// disable dynamic draw distance
//  0 - static
//  1 - dynamic
//  2 - very large
patch=1,EE,004A5768,extended,0
// set map draw distance to 2000
patch=1,EE,104a57b8,extended,07D0
// set object draw distance to 1500
patch=1,EE,104a57f8,extended,05DC
// set track draw distance to 600 - this one is the biggest performance hitter
patch=1,EE,104a5838,extended,0258
// set landscape transition to 500 - needs to be around track draw dist otherwise there are holes in the landscape
patch=1,EE,104a5878,extended,01F4


